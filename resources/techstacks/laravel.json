{
  "bakeResource": "bake/laravel.hcl",
  "bakeTarget": "ci",
  "imageServices": ["nginx", "php-fpm", "php-cli"],
  "pullServices": ["nginx", "php-fpm", "queue"],
  "securityServices": ["php-fpm"],
  "dependencyServices": ["mysql"],
  "migrateService": "php-cli",
  "migrateCmd": "php artisan migrate --force",
  "backupService": "mysql",
  "test": {
    "image": "ci-test",
    "label": "Pest tests",
    "env": {
      "APP_ENV": "testing",
      "DB_CONNECTION": "sqlite",
      "DB_DATABASE": ":memory:",
      "CACHE_STORE": "array",
      "QUEUE_CONNECTION": "sync"
    }
  }
}
